// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  // Relations
  clients    Client[]
  projects   Project[]
  learning_sessions LearningSession[]
  
  @@map("users")
}

model Client {
  id         String   @id @default(cuid())
  name       String
  company    String
  email      String?
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  // Documentation fields
  scraped_content     String?
  scraped_pages       Int?
  scraped_chars       Int?
  scraped_words       Int?
  scraped_at          DateTime?
  scraped_url         String?

  // Daily doc-monitoring
  monitoring_enabled  Boolean   @default(false)
  monitoring_root_url String?

  // Are this client's videos produced IN the StepByStep editor? true (default)
  // = new videos for this client can be auto-updated by the animation pipeline.
  // false = this client's videos are made elsewhere (e.g. OpenDictionary is cut
  // in Premiere), so every new video starts notify-only: check + email, human
  // updates the video. Only seeds Project.auto_update at creation — an
  // individual video can still be flipped afterwards.
  auto_update_default Boolean   @default(true)

  // Code-repo source (alternative to scraped docs). Files are uploaded from a
  // local folder or a .zip — no external credentials are ever stored.
  repo_label     String?    // folder or zip name shown in the UI
  repo_source    String?    // "folder" | "zip"
  repo_tree      Json?      // cached flat list of file paths (for the AI's file picker)
  repo_synced_at DateTime?

  // Relations
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  projects   Project[]
  learning_sessions   LearningSession[]
  snapshots           DocPageSnapshot[]
  check_runs          CheckRun[]
  repo_files          RepoFile[]
  repo_watch          RepoWatch?

  @@map("clients")
}

model Project {
  id                  String   @id @default(cuid())
  client_id           String
  title               String
  description         String
  documentation_urls  String[]
  prompt              String
  status              String
  script              String?
  user_id             String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  
  // New fields for scraped content
  scraped_content     String?
  scraped_pages       Int?
  scraped_chars       Int?
  scraped_words       Int?
  scraped_at          DateTime?
  scraped_url         String?
  video_type          String?

  // Authoring source: "docs" (crawl documentation) or "code" (uploaded repo +
  // repo-aware chat). Existing projects default to docs so nothing changes.
  source_type         String   @default("docs")

  // Repo-release monitoring: which committed feature-doc file(s) this video
  // covers (repo-relative paths, e.g. "docs/features/property-group.md"). When
  // one of these changes upstream, this project's script gets audited against
  // the change. Empty = not mapped to any feature doc yet.
  feature_doc_paths   String[] @default([])

  // UPDATE MODE. true (default) = the animation pipeline auto-updates this video
  // end-to-end (queue a RunRequest, launch the agent, re-render, re-sync) — new
  // videos are built in the StepByStep editor, so this is the norm.
  // false = the original system: when the product changes we only CHECK the
  // script and EMAIL a digest, and a human updates the video. Used for videos
  // produced outside the editor (Premiere, screen recordings). New videos
  // inherit Client.auto_update_default, so a whole client can stay manual.
  auto_update         Boolean  @default(true)

  // Which StepByStep editor project backs this video (library slug, e.g.
  // "newvideo"). Null = not made in the editor, so it can't be auto-updated.
  editor_project      String?

  // Relations
  user                User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client              Client         @relation(fields: [client_id], references: [id], onDelete: Cascade)
  pending_edits       PendingScriptEdit[]
  script_chat_messages ScriptChatMessage[]
  pipeline_runs       PipelineRun[]
  run_requests        RunRequest[]

  @@map("projects")
}

model LearningSession {
  id                    String   @id @default(cuid())
  client_id             String
  user_id               String
  software_name         String
  documentation_summary String?
  current_phase         String   @default("getting_started") // getting_started, exploring, practicing, mastering
  completion_percentage Float    @default(0.0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  
  // Relations
  user                  User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client                Client         @relation(fields: [client_id], references: [id], onDelete: Cascade)
  tasks                 LearningTask[]
  progress              LearningProgress[]
  chat_messages         LearningChatMessage[]
  
  @@map("learning_sessions")
}

model LearningTask {
  id                    String   @id @default(cuid())
  learning_session_id   String
  title                 String
  description           String
  instructions          String
  category              String   // navigation, basic_features, advanced_features, integrations, etc.
  difficulty_level      Int      @default(1) // 1-5
  estimated_minutes     Int?
  prerequisites         String[] // IDs of tasks that should be completed first
  is_completed          Boolean  @default(false)
  completed_at          DateTime?
  user_notes            String?
  created_at            DateTime @default(now())
  
  // Relations
  learning_session      LearningSession @relation(fields: [learning_session_id], references: [id], onDelete: Cascade)
  
  @@map("learning_tasks")
}

model LearningProgress {
  id                    String   @id @default(cuid())
  learning_session_id   String
  category              String   // Same as task categories
  mastery_level         Float    @default(0.0) // 0.0-1.0
  tasks_completed       Int      @default(0)
  total_tasks           Int      @default(0)
  last_activity         DateTime @default(now())
  
  // Relations
  learning_session      LearningSession @relation(fields: [learning_session_id], references: [id], onDelete: Cascade)
  
  @@unique([learning_session_id, category])
  @@map("learning_progress")
}

model LearningChatMessage {
  id                    String   @id @default(cuid())
  learning_session_id   String
  role                  String   // user, assistant, system
  content               String
  message_type          String   @default("chat") // chat, task_assignment, progress_update, guidance
  created_at            DateTime @default(now())
  
  // Relations
  learning_session      LearningSession @relation(fields: [learning_session_id], references: [id], onDelete: Cascade)
  
  @@map("learning_chat_messages")
}

// Snapshot of a single watched documentation page. The daily cron re-fetches
// each row's URL, compares the content hash, and only runs the AI pipeline
// when the hash differs.
model DocPageSnapshot {
  id              String   @id @default(cuid())
  client_id       String
  url             String
  title           String
  content_text    String
  content_hash    String
  last_checked_at DateTime @default(now())
  last_changed_at DateTime @default(now())
  created_at      DateTime @default(now())

  client          Client              @relation(fields: [client_id], references: [id], onDelete: Cascade)
  pending_edits   PendingScriptEdit[]

  @@unique([client_id, url])
  @@index([client_id])
  @@map("doc_page_snapshots")
}

// A persisted suggested edit awaiting user accept/decline. Produced by the
// cron pipeline; consumed by the existing ScriptWithOverlays UI.
// Note: actual_matched_text is intentionally NOT persisted — the client-side
// fuzzy matcher recomputes it at render time so it stays correct if the script
// gets edited between detection and review.
model PendingScriptEdit {
  id                    String    @id @default(cuid())
  project_id            String
  source_url            String
  source_snapshot_id    String?
  original_text         String
  suggested_replacement String
  reason                String
  severity              String    // critical | moderate | minor
  category              String    // missing_step | wrong_ui_element | incorrect_sequence | missing_detail
  status                String    @default("pending") // pending | accepted | declined
  detected_at           DateTime  @default(now())
  resolved_at           DateTime?

  project         Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  source_snapshot DocPageSnapshot? @relation(fields: [source_snapshot_id], references: [id], onDelete: SetNull)

  @@index([project_id, status])
  @@map("pending_script_edits")
}

// Audit log of cron runs (one per client per run). Used for detecting silent
// failures and skipping re-entrant runs.
model CheckRun {
  id             String    @id @default(cuid())
  client_id      String
  started_at     DateTime  @default(now())
  finished_at    DateTime?
  status         String    // running | success | partial | error
  pages_checked  Int       @default(0)
  pages_changed  Int       @default(0)
  pages_trivial  Int       @default(0)
  edits_proposed Int       @default(0)
  error_message  String?
  source         String    @default("docs") // "docs" (crawl) | "repo" (feature-doc watch)
  summary        String?   // one-line human-readable outcome, for the activity log

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id, started_at(sort: Desc)])
  @@map("check_runs")
}

// A single uploaded source file for a code-based client. Populated by the
// folder/zip upload flow; read on demand by the script-chat agent's read_files
// tool. Stored per client so all of that client's code projects share it.
model RepoFile {
  id         String   @id @default(cuid())
  client_id  String
  path       String
  content    String
  size       Int      @default(0)
  updated_at DateTime @default(now())

  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, path])
  @@index([client_id])
  @@map("repo_files")
}

// Per-project chat for code-based script authoring. Mirrors
// LearningChatMessage but scoped to a project. meta holds non-content metadata
// (e.g. which files the AI read, whether it wrote a draft this turn).
model ScriptChatMessage {
  id         String   @id @default(cuid())
  project_id String
  role       String   // user | assistant
  content    String
  meta       Json?
  created_at DateTime @default(now())

  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("script_chat_messages")
}

// ── Animation-pipeline mission control ──────────────────────────────────────
// A PipelineRun is one end-to-end animation-update of a video (the Fable pipeline:
// detect → edit animation → render → splice → [beats/re-sync] → ready-for-review).
// Written by the LOCAL pipeline via POST /api/pipeline/event (CRON_SECRET-authed),
// read by the mission-control dashboard. Independent of the cron's script-side
// PendingScriptEdit — this is the ANIMATION side.
model PipelineRun {
  id          String    @id @default(cuid())
  project_id  String    // the video this run updates
  status      String    @default("running") // running | ready_for_review | halted | error | done
  path        String?   // "A" (cosmetic) | "B" (beat-change)
  trigger     String?   // e.g. "OD-Test 8ac0970: activation note"
  phase       String?   // latest phase, denormalized from events for the board
  detail      String?   // latest human-readable line
  started_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  finished_at DateTime?

  project Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  events  PipelineEvent[]

  @@index([project_id, started_at(sort: Desc)])
  @@map("pipeline_runs")
}

// One step in a run's live stream. The board renders the latest per run; a run's
// detail view renders the whole ordered stream.
model PipelineEvent {
  id     String   @id @default(cuid())
  run_id String
  phase  String   // detect | brief | editing | written | reference | render | splice | proxy | beats | resync | ready | halt
  status String   @default("start") // start | progress | done | error
  detail String?
  data   Json?    // {part, frames, pct, ...}
  at     DateTime @default(now())

  run PipelineRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id, at])
  @@map("pipeline_events")
}

// The auto-trigger QUEUE. A push to a watched repo (e.g. OD-Test) creates one of these via the
// /api/pipeline/trigger webhook; the local poller claims it (serialized per project), pulls the
// repo, composes the brief, and launches the Fable agent. Survives the PC being off — a queued
// row just waits until the poller next comes online.
model RunRequest {
  id          String    @id @default(cuid())
  project_id  String    // the video this change targets
  repo        String    // "owner/name", e.g. "eslo34/OD-Test"
  sha         String
  ref         String?   // "refs/heads/main"
  queued_offline Boolean @default(false) // true if the PC was off when queued → ping "launching" on boot
  status      String    @default("queued") // queued | claimed | launched | done | error
  detail      String?
  created_at  DateTime  @default(now())
  claimed_at  DateTime?
  launched_at DateTime?
  finished_at DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([project_id, created_at(sort: Desc)])
  @@map("run_requests")
}

// Liveness of the local runner (poller). The webhook checks last_seen_at to decide whether the PC
// is on ("launching…") or off ("will run when your computer next starts"). id = the runner name.
model RunnerHeartbeat {
  id           String   @id // runner name, e.g. "local"
  last_seen_at DateTime @default(now())
  detail       String?

  @@map("runner_heartbeats")
}

// Configures repo-release monitoring for one client: which GitHub repo + branch
// to watch, which folder holds the committed feature docs, and how far we've
// processed. The daily cron compares `last_processed_sha…branch head`, routes
// changed feature docs to the videos mapped via Project.feature_doc_paths, and
// audits each affected script. Read-only: the token only ever needs Contents:Read.
model RepoWatch {
  id                 String    @id @default(cuid())
  client_id          String    @unique
  owner              String    // GitHub org/user, e.g. "bimobject"
  name               String    // repo name, e.g. "bim-dictionary"
  branch             String    @default("main")
  docs_path          String    @default("docs/features") // folder prefix that holds the feature docs
  last_processed_sha String?   // advanced only after a successful run; null on first run
  enabled            Boolean   @default(true)
  last_checked_at    DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@map("repo_watches")
}
